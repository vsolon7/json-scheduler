cabal-version:      3.0
name:               json-scheduler
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Vincent Solon
maintainer:         vsolon7@gmail.com
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
      Scheduler
    other-modules:
      Scheduler.Bell
    -- other-extensions:
    build-depends:
      base ^>=4.21.0.0,
      text ^>= 2.1.2,
      bytestring ^>= 0.12.2.0,
      sqlite-simple ^>=0.4.19.0,
      time ^>=1.14,
      aeson ^>= 2.2.5.1,
    hs-source-dirs:   src
    default-language: Haskell2010

test-suite json-scheduler-test
    import:           warnings
    default-language: Haskell2010
    -- other-modules:
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
      base ^>=4.21.0.0,
      json-scheduler
